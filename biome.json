{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!.hub",
      "!!node_modules",
      "!!.alchemy",
      "!!docs/brief.md",
      "!!kbpod-prompt.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {}
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": ["packages/api/src/**/*.ts", "apps/server/src/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "node:*",
                      "bun",
                      "bun:*",
                      "@effect/platform-bun",
                      "@effect/platform-bun/**",
                      "@effect/platform-node",
                      "@effect/platform-node/**"
                    ],
                    "message": "Keep Bun/Node adapters in host tooling, not the shared API or Worker."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
